{
    "name": "flytachi/file-store",
    "description": "File Store library",
    "type": "library",
    "license": "MIT",
    "keywords": ["file store", "extra store", "store"],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-detail": "vendor/bin/phpunit --testdox"
    },
    "autoload": {
        "psr-4": {
            "Flytachi\\FileStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flytachi\\FileStore\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "flytachi",
            "email": "jasur.rakhmatov03@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "squizlabs/php_codesniffer": "@stable"
    }
}
